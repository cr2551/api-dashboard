{
  "services": [
    {
      "name": "stripe",
      "type": "stripe",
      "intervalSeconds": 30,
      "timeoutSeconds": 10,
      "sla": {
        "maxP95LatencyMs": 1000,
        "minUptimePercent": 99.9,
        "windowMinutes": 60,
        "minSamples": 5,
        "consecutiveFailures": 2
      }
    },
    {
      "name": "github",
      "type": "http",
      "endpoint": "https://api.github.com/rate_limit",
      "intervalSeconds": 60,
      "sla": {
        "maxP95LatencyMs": 1500,
        "minUptimePercent": 99,
        "minSamples": 5,
        "consecutiveFailures": 2
      }
    },
    {
      "name": "frankfurter",
      "type": "http",
      "endpoint": "https://api.frankfurter.dev/v1/latest",
      "intervalSeconds": 60,
      "sla": {
        "maxP95LatencyMs": 1500,
        "minUptimePercent": 99,
        "minSamples": 5,
        "consecutiveFailures": 2
      }
    },
    {
      "name": "httpbin",
      "type": "http",
      "endpoint": "https://httpbin.org/status/200",
      "intervalSeconds": 60,
      "sla": {
        "maxP95LatencyMs": 3000,
        "minUptimePercent": 95,
        "minSamples": 5,
        "consecutiveFailures": 3
      }
    }
  ]
}
