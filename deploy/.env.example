# Template for deploy/.env (setup.sh creates it). The real .env holds secrets:
# keep it chmod 600 and never commit it (it is git-ignored).

# Public hostname pointing at this server; Caddy gets its HTTPS certificate.
DOMAIN=

# Bearer token every API request must send. setup.sh generates one; by hand:
# openssl rand -hex 32
API_TOKEN=

# Stripe test-mode key (sk_test_...). Only needed when services.json has a
# "stripe" service.
STRIPE_API_KEY=

# Optional push alerts, see "Alert channel: ntfy.sh" in the main README.
NTFY_TOPIC=
NTFY_SERVER=
NTFY_TOKEN=

# debug, info, warn or error.
LOG_LEVEL=info
